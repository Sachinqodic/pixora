{
  "name": "nodejs-app-structure",
  "version": "1.0.0",
  "description": "Pixora applications",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "rest-api",
    "rate-limiting",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.1028.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "rate-limiter-flexible": "^3.0.0",
    "redis": "^4.6.10",
    "sharp": "^0.33.5",
    "stripe": "^22.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.3"
  }
}
