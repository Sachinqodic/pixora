# Server Configuration
PORT=3000
NODE_ENV=development
SERVER_BASE_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/nodejs-app

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting Configuration
# Window in milliseconds (default: 15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Public endpoints (login, register, etc.) - Lower limit for security
RATE_LIMIT_PUBLIC=10
# Protected endpoints (authenticated routes) - Higher limit for usability
RATE_LIMIT_PROTECTED=100

# Redis Configuration (for rate limiting)
# Redis connection URL
REDIS_URL=redis://localhost:6379
# Redis password (optional, leave empty if no password)
REDIS_PASSWORD=

# Security Configuration
# JWT Secret (minimum 48 characters recommended)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-48-chars
# Bcrypt salt rounds (10-12 recommended)
BCRYPT_SALT_ROUNDS=12

# AWS S3 Configuration
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key


